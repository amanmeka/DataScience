    {
      "cell_type": "markdown",
      "source": [
        "New"
      ],
      "metadata": {
        "id": "57VOgPf4lYf3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# GEMINI helped me debug an error with variable names\n",
        "with pm.Model(coords=aa_coords) as cs_nh_model:\n",
        "    # hyperpriors\n",
        "    μ_mu_n = pm.StudentT('μ_mu', mu = 0, sigma = 10, nu = 30)\n",
        "    μ_sd_n = pm.HalfStudentT('μ_sd', nu = 30, sigma = 10) # Added nu for HalfStudentT\n",
        "    μ_nu_n = pm.HalfStudentT('μ_nu', nu = 30, sigma = 10) # Added nu for HalfStudentT\n",
        "\n",
        "    # priors\n",
        "    μ_n = pm.StudentT('μ', nu = μ_nu_n, mu = μ_mu_n, sigma = μ_sd_n, dims = \"aa\")\n",
        "\n",
        "    # Added prior for nu of v_n\n",
        "    nu_v_n = pm.HalfNormal('nu_v', sigma = 10)\n",
        "    v_n = pm.HalfStudentT('v', nu = nu_v_n, sigma = 10, dims = \"aa\") # Used nu_v_n here\n",
        "\n",
        "    σ_n = pm.HalfStudentT('σ', nu = 30, sigma = 10, dims = \"aa\") # Added nu for HalfStudentT\n",
        "\n",
        "    #likelihood\n",
        "    y_n = pm.StudentT('y', # Changed from pm.Normal to pm.StudentT\n",
        "                  nu = v_n[aa_idx],\n",
        "                  mu = μ_n[aa_idx],\n",
        "                  sigma = σ_n[aa_idx],\n",
        "                  observed = cs_data.diff_TminusE)\n",
        "\n",
        "    #hierarchical (h)\n",
        "    idata_cs_nh = pm.sample()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 125,
          "referenced_widgets": [
            "e69c0130ecbe4e54b84ae896e6e1535c",
