    {
      "cell_type": "markdown",
      "source": [
        "Ridge Plot Comparison"
      ],
      "metadata": {
        "id": "GmN2DDt-la49"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "axes = az.plot_forest([idata_cs_h, idata_cs_nh], kind=\"ridgeplot\",\n",
        "                      model_names=['hierarchical_normal', 'hierarchical_new'],\n",
        "                      var_names=['μ'], combined=True, figsize=(12, 10),hdi_prob=0.997)\n",
        "\n",
        "#plots overall mean of the hierarchical model; do not confuse with 0\n",
        "y_lims = axes[0].get_ylim()\n",
        "axes[0].vlines(idata_cs_h.posterior['μ_mu'].mean(), *y_lims, color=\"k\", ls=\":\");"
      ],
      "metadata": {
        "colab": {
